# LogicRush Root Configuration Template
PORT=4000
NODE_ENV=development

# Database - Optional PostgreSQL connection string (defaults to local SQLite if unset)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/logicrush

# Authentication
JWT_SECRET=replace-with-a-unique-random-secret

# Frontend origin; use the deployed Vercel origin in production
CLIENT_URL=http://localhost:5173
